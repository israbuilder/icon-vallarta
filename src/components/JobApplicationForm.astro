---
import { business } from "../data/business";

const positions = [
  "VIP Guest Concierge",
  "Luxury Property Manager",
  "Real Estate Sales Associate",
  "Front Desk & Hospitality Host",
  "Lead Maintenance & Facilities Tech",
  "Executive Housekeeping Supervisor",
  "Food & Beverage Beach Club Attendant",
  "Other Hospitality Role",
];
---
<form
  id="job-application-form"
  name="job-application"
  method="POST"
  action="/apply-received"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="grid gap-4"
  data-phone={business.phone}
>
  <input type="hidden" name="form-name" value="job-application" />
  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <div class="grid gap-1">
    <label for="ja-name" class="font-display font-semibold text-sm text-navy">Full Name</label>
    <input
      id="ja-name"
      name="name"
      required
      autocomplete="name"
      placeholder="Your full name"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    />
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-1">
      <label for="ja-phone" class="font-display font-semibold text-sm text-navy">Phone / WhatsApp</label>
      <input
        id="ja-phone"
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        placeholder="+52 / +1 …"
        class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
      />
    </div>

    <div class="grid gap-1">
      <label for="ja-email" class="font-display font-semibold text-sm text-navy">Email Address</label>
      <input
        id="ja-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@hospitality.com"
        class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
      />
    </div>
  </div>

  <div class="grid gap-1">
    <label for="ja-position" class="font-display font-semibold text-sm text-navy">Position Applying For</label>
    <select
      id="ja-position"
      name="position"
      required
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    >
      <option value="" disabled selected>Select a position…</option>
      {positions.map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <div class="grid gap-1">
    <label for="ja-experience" class="font-display font-semibold text-sm text-navy">
      Years in Luxury Hospitality / Real Estate <span class="text-navy/50 font-normal">(optional)</span>
    </label>
    <input
      id="ja-experience"
      name="experience"
      placeholder="e.g. 4 years in luxury resort concierge"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    />
  </div>

  <div class="grid gap-1">
    <label for="ja-message" class="font-display font-semibold text-sm text-navy">
      Languages &amp; Background <span class="text-navy/50 font-normal">(English, Spanish, etc.)</span>
    </label>
    <textarea
      id="ja-message"
      name="message"
      rows="4"
      placeholder="Tell us about your background, customer service philosophy, and certifications…"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    ></textarea>
  </div>

  <div class="grid gap-1">
    <label for="ja-resume" class="font-display font-semibold text-sm text-navy">
      Resume / CV <span class="text-navy/50 font-normal">(PDF or Word, max 5 MB)</span>
    </label>
    <input
      id="ja-resume"
      name="resume"
      type="file"
      accept=".pdf,.doc,.docx,.txt,application/pdf,application/msword"
      class="text-navy text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-navy file:px-4 file:py-2.5 file:font-display file:font-semibold file:text-brass hover:file:bg-navy-700 file:cursor-pointer border border-navy/20 bg-white rounded-lg py-1.5 px-2"
    />
  </div>

  <button
    type="submit"
    id="ja-submit"
    class="hp-lift mt-2 bg-navy hover:bg-navy-700 text-brass font-display font-bold py-3.5 px-6 rounded-lg tracking-wide shadow-md transition-all duration-300"
  >
    Submit Application
  </button>
</form>

<p id="ja-status" role="status" aria-live="polite" class="text-sm mt-2"></p>

<script>
  const form = document.getElementById("job-application-form") as HTMLFormElement | null;
  const status = document.getElementById("ja-status");
  const resume = document.getElementById("ja-resume") as HTMLInputElement | null;
  const MAX_RESUME_BYTES = 5 * 1024 * 1024;

  if (form && status) {
    form.addEventListener("submit", (e) => {
      const file = resume?.files?.[0];
      if (file && file.size > MAX_RESUME_BYTES) {
        e.preventDefault();
        status.textContent = "Your resume is over 5 MB — please attach a smaller file.";
        status.className = "text-sm text-red-700 font-medium";
      }
    });
  }
</script>
