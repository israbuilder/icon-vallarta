---
import { business } from "../data/business";
import { areas } from "../data/areas";
import { getCollection } from "astro:content";

const year = new Date().getFullYear();
const navLinks = [
  { href: "/services", label: "Residences & Services" },
  { href: "/meet-hugo", label: "Architecture" },
  { href: "/projects", label: "Gallery" },
  { href: "/areas-we-serve", label: "Destinations" },
  { href: "/coupons", label: "Offers" },
  { href: "/community-mission", label: "Sustainability" },
  { href: "/blog", label: "Blog" },
  { href: "/careers", label: "Careers" },
  { href: "/contact", label: "Contact" },
];

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<footer class="bg-navy-800 text-white border-t border-navy-700">
  <div class="max-w-7xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center justify-center h-10 w-10 rounded-lg bg-brass text-navy font-display font-black text-xl">
          IV
        </span>
        <div class="flex flex-col">
          <span class="font-display font-black text-xl tracking-wider text-white leading-none">
            ICON VALLARTA
          </span>
          <span class="text-[10px] uppercase font-bold tracking-[0.25em] text-brass-light mt-0.5">
            Residences &amp; Resort
          </span>
        </div>
      </div>
      <p class="mt-4 font-display text-sm text-brass-light italic">
        "World-Class Oceanfront Living by Philippe Starck &amp; Arquitectonica"
      </p>
      <p class="mt-2 text-xs text-white/70 leading-relaxed">
        Three iconic beachfront towers and private villas in Puerto Vallarta's prestigious North Hotel Zone.
      </p>
    </div>

    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-widest">Residences &amp; Services</h2>
      <ul class="mt-4 space-y-2.5 text-xs">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.id}`} class="text-white/80 hover:text-brass-light transition-colors">
              {s.data.h1}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-widest">Destinations &amp; Enclaves</h2>
      <ul class="mt-4 space-y-2.5 text-xs">
        {areas.slice(0, 5).map((a) => (
          <li>
            <a href={`/areas/${a.slug}`} class="text-white/80 hover:text-brass-light transition-colors">
              {a.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/areas-we-serve" class="font-bold text-water-light hover:text-white transition-colors">
            All destinations →
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-display font-bold text-brass-light uppercase text-xs tracking-widest">Concierge &amp; Inquiries</h2>
      <a href={business.phoneHref} class="mt-4 block font-display text-xl font-bold hover:text-brass-light transition-colors">
        {business.phone}
      </a>
      <p class="mt-1.5 text-xs text-brass-light font-medium">{business.hoursDisplay}</p>
      <p class="mt-3 text-xs text-white/80 leading-relaxed">{business.address}</p>
      <p class="mt-1 text-xs text-white/60">Serving {business.areaServed}</p>

      <div class="mt-5 flex gap-2.5">
        <a href={business.socials.facebook} aria-label={`${business.name} on Facebook`} class="p-2 rounded-lg bg-white/10 hover:bg-brass hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href={business.socials.instagram} aria-label={`${business.name} on Instagram`} class="p-2 rounded-lg bg-white/10 hover:bg-brass hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
        </a>
        <a href={business.socials.google} aria-label={`${business.name} on Google`} class="p-2 rounded-lg bg-white/10 hover:bg-brass hover:text-navy transition-colors" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12v3.6h5.1c-.2 1.3-1.6 3.9-5.1 3.9-3.1 0-5.6-2.6-5.6-5.7s2.5-5.7 5.6-5.7c1.8 0 2.9.8 3.6 1.4l2.5-2.4C16.9 4.9 14.7 4 12 4 6.9 4 2.8 8.1 2.8 13.2S6.9 22.4 12 22.4c5.9 0 9.7-4.1 9.7-9.9 0-.7-.1-1.2-.2-1.7H12z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <nav aria-label="Footer" class="max-w-7xl mx-auto px-6 pt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs text-white/70">
      {navLinks.map((l) => (
        <a href={l.href} class="hover:text-brass-light transition-colors">{l.label}</a>
      ))}
    </nav>
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/50">
      <p>© {year} {business.name}. {business.license}.</p>
      <p>{business.trustedPhrase} · {business.areaServed}</p>
    </div>
  </div>
</footer>
