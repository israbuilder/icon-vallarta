---
import { business } from "../data/business";
---
<form
  id="request-service-form"
  method="POST"
  action="/api/request-service"
  class="grid gap-4"
  data-phone={business.phone}
>
  <div class="grid gap-1">
    <label for="rs-name" class="font-display font-semibold text-sm text-navy">Full Name</label>
    <input
      id="rs-name"
      name="name"
      required
      autocomplete="name"
      placeholder="Your full name"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    />
  </div>

  <div class="grid gap-1 sm:grid-cols-2 sm:gap-4">
    <div class="grid gap-1">
      <label for="rs-phone" class="font-display font-semibold text-sm text-navy">Phone / WhatsApp</label>
      <input
        id="rs-phone"
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        placeholder="+1 (555) 000-0000"
        class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
      />
    </div>

    <div class="grid gap-1">
      <label for="rs-email" class="font-display font-semibold text-sm text-navy">Email Address</label>
      <input
        id="rs-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@luxurytravel.com"
        class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
      />
    </div>
  </div>

  <div class="grid gap-1">
    <label for="rs-address" class="font-display font-semibold text-sm text-navy">
      Interested In / Residence Type <span class="text-navy/50 font-normal">(optional)</span>
    </label>
    <input
      id="rs-address"
      name="address"
      placeholder="e.g. 2-Bedroom Vacation Rental, Penthouse Purchase, Property Management"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    />
  </div>

  <div class="grid gap-1">
    <label for="rs-problem" class="font-display font-semibold text-sm text-navy">Tell Us About Your Dates or Inquiry</label>
    <textarea
      id="rs-problem"
      name="problem"
      required
      rows="4"
      placeholder="Please provide your planned travel dates, number of guests, or specific real estate questions…"
      class="border border-navy/20 bg-white px-3.5 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
    ></textarea>
  </div>

  <button
    type="submit"
    id="rs-submit"
    class="hp-lift mt-2 bg-navy hover:bg-navy-700 text-brass font-display font-bold py-3.5 px-6 rounded-lg tracking-wide shadow-md transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
  >
    Submit Inquiry
  </button>
</form>

<p id="rs-status" role="status" aria-live="polite" class="text-sm mt-3"></p>

<script>
  const form = document.getElementById("request-service-form") as HTMLFormElement | null;
  const status = document.getElementById("rs-status");
  const submit = document.getElementById("rs-submit") as HTMLButtonElement | null;
  const phone = form?.dataset.phone ?? "";

  const leadSource = (): string => {
    try {
      const m = document.cookie.match(/(?:^|; )hp_attrib=([^;]+)/);
      if (!m) return "direct / none";
      const a = JSON.parse(decodeURIComponent(m[1]));
      const parts = [a.src || "?", a.med || "?"];
      if (a.camp) parts.push(a.camp);
      if (a.cont) parts.push(a.cont);
      let s = parts.join(" / ");
      if (a.lp) s += ` — landed ${a.lp}`;
      if (a.d) s += ` on ${a.d}`;
      return s;
    } catch {
      return "unknown";
    }
  };

  if (form && status && submit) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      status.textContent = "Sending your inquiry to our concierge…";
      status.className = "text-sm text-navy/70";
      const source = leadSource();

      try {
        const netlifyBody = new URLSearchParams();
        netlifyBody.append("form-name", "request-service");
        for (const [k, v] of new FormData(form).entries()) {
          netlifyBody.append(k, typeof v === "string" ? v : "");
        }
        netlifyBody.append("lead_source", source);
        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: netlifyBody.toString(),
        }).catch(() => {});
      } catch {}

      try {
        const apiBody = new FormData(form);
        apiBody.append("lead_source", source);
        const res = await fetch(form.action, {
          method: "POST",
          body: apiBody,
        });
        if (res.ok) {
          form.reset();
          form.hidden = true;
          status.textContent = "Thank you. Your inquiry has been received. Our VIP concierge will contact you shortly.";
          status.className = "text-sm text-green-700 font-bold p-4 bg-green-50 rounded-xl border border-green-200";
        } else {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch {
        submit.disabled = false;
        status.textContent = `Something went wrong. Please reach out to our concierge directly at ${phone}.`;
        status.className = "text-sm text-red-700 font-medium";
      }
    });
  }
</script>
