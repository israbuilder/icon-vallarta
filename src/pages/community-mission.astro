---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`Sustainability & Coastal Stewardship | ${business.name}`}
  description={`${business.name} is committed to sustainable coastal luxury, sea turtle conservation, and positive community engagement in Puerto Vallarta.`}
  path="/community-mission"
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28 text-center">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">
        Environmental &amp; Community Care
      </p>
      <h1 class="hp-rise mt-4 font-display font-black text-4xl sm:text-5xl lg:text-6xl max-w-3xl mx-auto leading-tight">
        Preserving Banderas Bay's Natural Heritage
      </h1>
      <p class="mt-6 text-white/80 text-lg sm:text-xl max-w-2xl mx-auto font-light leading-relaxed">
        Beyond world-class architecture, we believe in protecting Puerto Vallarta's marine ecosystems, supporting local artisan communities, and promoting eco-conscious hospitality.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/contact"
          class="hp-lift inline-flex items-center justify-center bg-brass hover:bg-brass-dark text-navy px-8 py-3.5 rounded-lg font-display font-bold transition-colors"
        >
          Connect With Us
        </a>
        <ScheduleButton class="px-8 py-3.5" label="Inquire Today" />
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-navy">
        Our Core Stewardship Commitments
      </h2>
      <p class="mt-4 text-navy/70 text-lg">
        How {business.name} honors the environment and community that make our home extraordinary.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-water/10 flex items-center justify-center text-water font-bold text-2xl mb-6">
            🌊
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Marine &amp; Turtle Protection</h3>
          <p class="mt-3 text-navy/75 leading-relaxed text-sm">
            We actively support local sea turtle nesting sanctuaries along our beachfront, promoting responsible night lighting and beach cleanliness during hatching season.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brass/10 flex items-center justify-center text-brass font-bold text-2xl mb-6">
            🌿
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Energy &amp; Water Efficiency</h3>
          <p class="mt-3 text-navy/75 leading-relaxed text-sm">
            Tinted low-emission glass, efficient VRF climate systems, and on-site water management minimize ecological impact while maintaining absolute resident luxury.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-8 shadow-sm border border-navy/10 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-flame/10 flex items-center justify-center text-flame font-bold text-2xl mb-6">
            🤝
          </div>
          <h3 class="font-display font-bold text-xl text-navy">Local Culture &amp; Artisans</h3>
          <p class="mt-3 text-navy/75 leading-relaxed text-sm">
            We partner with Jalisco and Nayarit indigenous artisans, ethical local fishermen, and regional charities to keep tourism benefits rooted in our community.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-navy text-white py-16 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl">
        Experience Sustainable Luxury on Banderas Bay
      </h2>
      <p class="mt-4 text-white/80 text-lg">
        Contact our concierge at <a href={business.phoneHref} class="font-bold text-brass-light hover:underline">{business.phone}</a> or reserve your residence online.
      </p>
      <div class="mt-8 flex justify-center">
        <ScheduleButton class="px-8 py-4 text-base" label="Plan Your Visit" />
      </div>
    </div>
  </section>
</BaseLayout>
