---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import { business } from "../../data/business";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Residences & Luxury Services | ${business.name}`}
  description={`Explore Icon Vallarta luxury beachfront condominiums, vacation rentals, real estate sales, and bespoke concierge services in Puerto Vallarta.`}
  path="/services"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">Residences &amp; Services</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Icon Vallarta Services &amp; Living</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        From designer vacation rentals and penthouse sales to turnkey property management and private yacht concierge, explore everything Icon Vallarta offers.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((svc) => (
        <a href={`/services/${svc.id}`} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-xl p-6 flex flex-col">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-navy text-brass">
            ✦
          </span>
          <h2 class="mt-4 font-display font-bold text-lg text-navy group-hover:text-water transition-colors">{svc.data.h1}</h2>
          <p class="mt-2 text-sm text-navy/60 flex-1">{svc.data.summary}</p>
          <span class="mt-4 font-display font-bold text-brass text-sm group-hover:text-navy transition-colors">Learn more →</span>
        </a>
      ))}
    </div>

    <div class="mt-14 bg-cream border border-navy/10 rounded-2xl p-8 text-center">
      <h2 class="font-display font-extrabold text-2xl text-navy">Looking for a Customized Residence Package?</h2>
      <p class="mt-2 text-navy/70">Connect with our on-site team for private tours, long-term rentals, or ownership inquiries. Call {business.phone}.</p>
      <div class="mt-6 flex justify-center"><ScheduleButton class="px-7 py-3.5" label="Inquire With Concierge" /></div>
    </div>
  </section>
</BaseLayout>
