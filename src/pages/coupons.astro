---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";

const fine = "Valid on select direct bookings and vacation stays. Cannot be combined with other promotional codes. Inquire for blackout dates.";
const coupons = [
  { amount: "$150 CREDIT", title: "Resort & Beach Club Credit", detail: "Applied toward pool bar dining, spa treatments, or private cabana service on 4+ night stays." },
  { amount: "15% OFF", title: "Extended Coastal Escape", detail: "Enjoy 15% off weekly or monthly residence stays during shoulder and summer seasons." },
  { amount: "FREE TRANSFER", title: "VIP Airport Chauffeur", detail: "Complimentary round-trip luxury private SUV airport transfer on penthouse bookings." },
  { amount: "$300 OFF", title: "Private Yacht Charter Credit", detail: "Applied to private Banderas Bay sunset or snorkeling catamaran charters on direct stays." },
];
---
<BaseLayout
  title={`Exclusive Offers & Credits | ${business.name}`}
  description={`Exclusive stay credits and seasonal booking privileges for Icon Vallarta beachfront condominiums in Puerto Vallarta.`}
  path="/coupons"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-5xl mx-auto px-6 py-8 sm:py-14">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">Direct Booking Privileges</p>
      <h1 class="hp-rise mt-2 font-display font-black text-3xl sm:text-5xl">Exclusive Offers &amp; Stay Credits</h1>
    </div>
  </section>

  <section class="px-6 py-6 sm:py-16 max-w-5xl mx-auto">
    <div id="coupon-wrap" class="relative" data-locked>
      <p id="coupon-msg" role="status" aria-live="polite" class="hidden mb-6 text-center font-display font-bold text-lg"></p>
      <div id="coupon-grid" class="grid gap-8 sm:grid-cols-2">
        {coupons.map((c) => (
          <div class="hp-lift relative flex flex-col bg-white rounded-2xl shadow-lg border-2 border-dashed border-brass overflow-hidden">
            <div class="flex-1 p-8 text-center">
              <span class="inline-block bg-brass text-navy font-display font-bold text-xs uppercase tracking-[0.2em] px-3.5 py-1 rounded-full">VIP Privilege</span>
              <p class="mt-4 font-display font-black text-3xl sm:text-4xl text-navy">{c.amount}</p>
              <h2 class="mt-3 font-display font-extrabold text-xl text-navy">{c.title}</h2>
              <p class="mt-2 text-navy/70 text-sm leading-relaxed">{c.detail}</p>
            </div>

            <div class="px-8 pb-8">
              <ScheduleButton class="w-full px-6 py-3 text-base" label="Claim Privilege" />
              <p class="mt-4 text-xs text-navy/45 italic leading-relaxed text-center">{fine}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Unlock gate -->
      <div id="coupon-gate" class="absolute inset-0 z-10 flex items-start justify-center px-2 pt-2 sm:pt-14">
        <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border-2 border-brass p-6 sm:p-8">
          <h2 class="font-display font-extrabold text-2xl text-navy text-center">Unlock Exclusive VIP Credits</h2>
          <p class="mt-2 text-navy/70 text-center text-sm">
            Receive exclusive booking codes and seasonal resort credits sent to your phone.
          </p>
          <form id="coupon-form" class="mt-5 grid gap-4" data-phone={business.phone}>
            <div class="grid gap-1">
              <label for="cl-name" class="font-display font-semibold text-sm text-navy">Name</label>
              <input
                id="cl-name"
                name="name"
                required
                autocomplete="name"
                placeholder="Your full name"
                class="border border-navy/20 bg-white px-3 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
              />
            </div>
            <div class="grid gap-1">
              <label for="cl-phone" class="font-display font-semibold text-sm text-navy">Mobile Number / WhatsApp</label>
              <input
                id="cl-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="+1 (555) 000-0000"
                class="border border-navy/20 bg-white px-3 py-2.5 rounded-lg text-navy focus:outline-none focus:ring-2 focus:ring-brass focus:border-brass transition"
              />
            </div>
            <button
              type="submit"
              id="cl-submit"
              class="hp-lift mt-1 bg-navy hover:bg-navy-700 text-brass px-5 py-3 rounded-lg font-display font-bold tracking-tight shadow-lg transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Send Me My Exclusive Credits
            </button>
            <p class="text-[11px] leading-relaxed text-navy/50 text-center">
              We respect your privacy. Inquiries are handled directly by our private concierge.
            </p>
          </form>
          <p id="cl-status" role="status" aria-live="polite" class="mt-2 text-sm text-center"></p>
        </div>
      </div>
    </div>

    <p class="mt-10 text-center text-navy/70 text-sm">
      Questions regarding current promotions? Call
      <a href={business.phoneHref} class="font-bold text-water hover:text-navy transition-colors">{business.phone}</a>.
    </p>
  </section>

  <style>
    #coupon-wrap[data-locked] #coupon-grid {
      filter: blur(10px);
      pointer-events: none;
      user-select: none;
    }
    #coupon-grid {
      transition: filter 0.5s ease;
    }
    #coupon-wrap:not([data-locked]) #coupon-gate {
      display: none;
    }
  </style>

  <script is:inline>
    try {
      if (localStorage.getItem("hp_coupons_unlocked") === "1") {
        document.getElementById("coupon-wrap").removeAttribute("data-locked");
      }
    } catch (e) {}
  </script>

  <script>
    const wrap = document.getElementById("coupon-wrap");
    const gate = document.getElementById("coupon-gate");
    const form = document.getElementById("coupon-form") as HTMLFormElement | null;
    const status = document.getElementById("cl-status");
    const msg = document.getElementById("coupon-msg");
    const submit = document.getElementById("cl-submit") as HTMLButtonElement | null;

    const leadSource = (): string => {
      try {
        const m = document.cookie.match(/(?:^|; )hp_attrib=([^;]+)/);
        if (!m) return "direct / none";
        const a = JSON.parse(decodeURIComponent(m[1]));
        const parts = [a.src || "?", a.med || "?"];
        if (a.camp) parts.push(a.camp);
        if (a.cont) parts.push(a.cont);
        let s = parts.join(" / ");
        if (a.lp) s += ` — landed ${a.lp}`;
        if (a.d) s += ` on ${a.d}`;
        return s;
      } catch {
        return "unknown";
      }
    };

    const unlock = () => {
      wrap?.removeAttribute("data-locked");
    };

    const showMsg = (text: string, colorClass: string) => {
      if (!msg) return;
      msg.textContent = text;
      msg.className = `mb-6 text-center font-display font-bold text-lg ${colorClass}`;
    };

    if (wrap && gate && form && status && submit) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const phoneDigits = (
          (form.elements.namedItem("phone") as HTMLInputElement)?.value ?? ""
        ).replace(/\D/g, "");
        if (phoneDigits.length < 10) {
          status.textContent = "Please double-check your mobile number.";
          status.className = "mt-2 text-sm text-center text-red-700 font-medium";
          return;
        }

        submit.disabled = true;
        status.textContent = "Sending your exclusive credits…";
        status.className = "mt-2 text-sm text-center text-gray-600";

        try {
          const body = new FormData(form);
          body.append("lead_source", leadSource());
          const res = await fetch("/api/coupon-lead", { method: "POST", body });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.ok) {
            try {
              localStorage.setItem("hp_coupons_unlocked", "1");
            } catch {}
            showMsg("📲 Sent! Check your messages for your VIP code.", "text-green-700");
            unlock();
          } else {
            showMsg("Your privileges are unlocked below. Mention them when booking.", "text-navy/70");
            unlock();
          }
        } catch {
          showMsg("Your privileges are unlocked below. Mention them when booking.", "text-navy/70");
          unlock();
        }
      });
    }
  </script>
</BaseLayout>
