---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleButton from "../../components/ScheduleButton.astro";
import RealWorkWidget from "../../components/RealWorkWidget.astro";
import { business } from "../../data/business";
import { areas } from "../../data/areas";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  const svcMap = Object.fromEntries(services.map((s) => [s.id, s.data]));
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area, svcMap } }));
}

const { area, svcMap } = Astro.props;
const url = `${business.url}/areas/${area.slug}`;

const topServices = area.topServices
  .map((slug: string) => ({ slug, data: svcMap[slug] }))
  .filter((s: { data: any }) => s.data);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "@id": `${business.url}/#business`,
  name: business.name,
  telephone: business.phone,
  url,
  image: business.url + business.logo,
  priceRange: business.priceRange,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.addressParts.street,
    addressLocality: business.addressParts.city,
    addressRegion: business.addressParts.state,
    postalCode: business.addressParts.zip,
    addressCountry: "MX",
  },
  areaServed: { "@type": "City", name: `${area.name}, Mexico` },
  openingHours: business.hours,
  sameAs: [business.socials.facebook, business.socials.instagram, business.socials.google],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Destinations", item: `${business.url}/areas-we-serve` },
    { "@type": "ListItem", position: 3, name: area.name, item: url },
  ],
};
---
<BaseLayout
  title={area.seoTitle}
  description={area.metaDescription}
  path={`/areas/${area.slug}`}
  jsonLd={[localBusinessSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy text-white border-b-4 border-brass">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <a href="/areas-we-serve" class="font-display font-bold text-brass-light text-sm hover:text-white transition-colors">← All destinations</a>
      <p class="mt-4 font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">{area.heroEyebrow}</p>
      <h1 class="hp-rise mt-2 font-display font-black text-4xl sm:text-5xl">{area.h1}</h1>
      <p class="mt-4 text-white/85 text-lg max-w-2xl">Five-star oceanfront living and bespoke guest services connecting you with {area.name}.</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <ScheduleButton class="px-7 py-3.5 text-base" label="Reserve Your Residence" />
        <a href={business.phoneHref} class="hp-lift inline-flex items-center justify-center gap-2 border-2 border-brass text-brass-light hover:bg-brass hover:text-navy px-7 py-3.5 rounded-lg font-display font-bold text-base transition-colors">
          Call Concierge {business.phone}
        </a>
      </div>
    </div>
  </section>

  <section class="px-6 py-14 max-w-5xl mx-auto">
    <div class="prose max-w-none">
      {area.intro.map((p: string) => <p>{p}</p>)}
    </div>

    <!-- Local context -->
    <div class="mt-10 bg-cream border-l-4 border-brass rounded-r-xl p-7 shadow-sm">
      <h2 class="font-display font-extrabold text-2xl text-navy">The Icon Vallarta Difference in {area.name}</h2>
      <p class="mt-3 text-navy/80 text-lg leading-relaxed">{area.localChallenges}</p>
    </div>

    <!-- Top services for this area -->
    <h2 class="mt-12 font-display font-extrabold text-2xl text-navy mb-5">Curated Services for {area.name}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {topServices.map((s: { slug: string; data: any }) => (
        <a href={`/services/${s.slug}`} class="hp-lift group block bg-white border border-navy/10 rounded-xl p-5 shadow-sm hover:border-brass/40 hover:shadow-md">
          <span class="font-display font-bold text-navy group-hover:text-water transition-colors">{s.data.h1}</span>
          <span class="block text-sm text-navy/60 mt-1">{s.data.summary}</span>
        </a>
      ))}
    </div>

    <RealWorkWidget targetId="rwl-map" />

    <!-- CTA -->
    <div class="mt-14 bg-navy text-white rounded-2xl p-8 text-center">
      <h2 class="font-display font-extrabold text-2xl">Ready to Explore {area.name}?</h2>
      <p class="mt-2 text-white/85">Inquire about vacation rentals, real estate tours, or private concierge bookings.</p>
      <div class="mt-6 flex justify-center"><ScheduleButton class="px-7 py-3.5 text-base" label="Inquire With Concierge" /></div>
    </div>
  </section>
</BaseLayout>
