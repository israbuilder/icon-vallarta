---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import RequestServiceForm from "../components/RequestServiceForm.astro";
import { business } from "../data/business";
---
<BaseLayout
  title={`Contact & Concierge | ${business.name}`}
  description={`Connect with the Icon Vallarta on-site management and concierge team. Reservations, real estate tours, and private yacht inquiries.`}
  path="/contact"
>
  <!-- Banner -->
  <section class="bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">At Your Service 24/7</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Connect With Icon Vallarta</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        Whether planning your next luxury vacation, seeking real estate acquisitions, or requesting VIP concierge assistance, our team is ready.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid gap-12 md:grid-cols-2">
      <!-- Contact details -->
      <div class="space-y-8">
        <div class="bg-white rounded-2xl border border-navy/10 shadow-sm p-7">
          <h2 class="font-display font-bold text-xl text-navy">Direct Online Booking</h2>
          <p class="mt-2 text-navy/70 text-sm">Reserve your luxury condominium or penthouse directly through our secure platform.</p>
          <div class="mt-5"><ScheduleButton class="px-7 py-3.5" label="Book Your Stay" /></div>
        </div>

        <div class="bg-navy text-white rounded-2xl p-7 shadow-md">
          <h2 class="font-display font-bold text-xl text-brass-light">Call Concierge</h2>
          <a href={business.phoneHref} class="mt-3 block font-display font-black text-2xl sm:text-3xl hover:text-brass-light transition-colors">{business.phone}</a>
          <p class="mt-2 text-xs text-brass-light font-semibold">{business.hoursDisplay}</p>
        </div>

        <div class="bg-white rounded-2xl border border-navy/10 shadow-sm p-7">
          <h2 class="font-display font-bold text-xl text-navy">Resort Address</h2>
          <p class="mt-2 text-navy/70 text-sm leading-relaxed">{business.address}</p>
          <p class="mt-2 text-xs text-navy/50">Direct Beachfront Access · North Hotel Zone, Puerto Vallarta</p>
        </div>
      </div>

      <!-- Request service / booking form -->
      <div class="bg-cream rounded-2xl border border-navy/10 shadow-sm p-7 sm:p-8">
        <h2 class="font-display font-bold text-2xl text-navy">Send an Inquiry</h2>
        <p class="mt-2 mb-6 text-navy/70 text-sm">Please tell us about your planned travel dates, guests, or real estate questions.</p>
        <RequestServiceForm />
      </div>
    </div>
  </section>
</BaseLayout>
