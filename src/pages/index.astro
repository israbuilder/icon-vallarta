---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
import { getCollection } from "astro:content";
import Reviews from "../components/Reviews.astro";
import RequestServiceForm from "../components/RequestServiceForm.astro";
import { getPosts, formatPostDate } from "../lib/blog-api";

// Core pillars of Icon Vallarta
const highlights = [
  {
    title: "Luxury Vacation Residences",
    desc: "1 to 3-bedroom oceanfront suites and residences with private elevator entry, wrap-around terraces, and full resort privileges.",
    accent: "brass",
    icon: "building",
    link: "/services/condominios-2-recamaras",
  },
  {
    title: "Penthouses & Beach Villas",
    desc: "Prime Pacific beachfront top-floor penthouses and private ocean villas designed by Philippe Starck with rooftop plunge pools.",
    accent: "water",
    icon: "key",
    link: "/services/penthouses-de-lujo",
  },
  {
    title: "VIP Concierge & Experiences",
    desc: "Turnkey luxury vacation experience: private yacht charters, private chefs, airport transfers, and 24/7 dedicated guest care.",
    accent: "flame",
    icon: "shield",
    link: "/services/servicios-concierge-vip",
  },
];

const painPoints = [
  "Seeking genuine oceanfront luxury in Puerto Vallarta without crowded hotel lobbies?",
  "Want a designer private residence with five-star hotel amenities and beach service?",
  "Looking for spacious 1, 2, or 3-bedroom condos with direct elevator access and sunset views?",
  "Need dependable on-site concierge, housekeeping, and pre-arrival grocery provisioning?",
  "Desiring private elevator access and uninterrupted panoramic Pacific sunset views?",
  "Planning a luxury family retreat or VIP getaway with private chefs and yacht charters?",
];

const stats = [
  {
    type: "rating",
    link: business.socials.google,
    title: `${business.rating.count}+`,
    label: `${business.rating.value}★ Verified Reviews`,
  },
  {
    type: "years",
    link: "/meet-hugo",
    title: "3 Towers",
    label: "Iconic Starck Architecture",
  },
  {
    type: "beach",
    link: "/services/villas-frente-al-mar",
    title: "500 Ft",
    label: "Heated Infinity Pools",
  },
  {
    type: "service",
    link: "/contact",
    title: "24/7",
    label: "Concierge & Security",
  },
];

const galleryProjects = [
  { src: "/images/placeholder.jpeg", alt: "Icon Vallarta panoramic oceanfront towers in Puerto Vallarta" },
  { src: "/images/placeholder.jpeg", alt: "Triple infinity swimming pool overlooking Banderas Bay" },
  { src: "/images/placeholder.jpeg", alt: "Designer penthouse living room with private terrace by Philippe Starck" },
  { src: "/images/placeholder.jpeg", alt: "Exclusive beachfront club and cabanas on the golden sand" },
];

// Fetch featured posts dynamically from Headless CMS API
const postsResponse = await getPosts({ per_page: 3, page: 1 });
const featuredPosts = postsResponse.data || [];

const allServices = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title={`Icon Vallarta | Luxury Beachfront Condos & Residences in Puerto Vallarta`}
  description={`Experience Icon Vallarta: world-class beachfront condominium residences, luxury vacation rentals, sales, and concierge in Puerto Vallarta, Mexico. Call ${business.phone}.`}
  path="/"
  includeReviews={true}
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-navy text-white min-h-[600px] sm:min-h-[700px] flex items-center">
    <img
      src="/images/hero-bg.jpg"
      alt="Icon Vallarta beachfront resort and luxury residences"
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <!-- Gradient overlays for readability and luxury cinematic feel -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/40"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy via-transparent to-navy/40"></div>

    <div class="max-w-7xl mx-auto px-6 py-20 sm:py-28 lg:py-32 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-navy-800/80 backdrop-blur-md border border-brass/40 px-4 py-1 text-xs font-bold uppercase tracking-[0.2em] text-brass-light mb-6 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-brass animate-pulse"></span>
          YOO Inspired by Starck · Puerto Vallarta
        </div>

        <h1 class="hp-rise font-display font-black text-4xl sm:text-6xl lg:text-7xl leading-tight text-white drop-shadow-md">
          Oceanfront Luxury <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brass-light via-brass to-water-light">
            Redefined.
          </span>
        </h1>

        <p class="hp-rise hp-delay-1 mt-6 text-lg sm:text-xl text-white/90 leading-relaxed max-w-2xl font-light drop-shadow">
          Three iconic 31-story glass towers on the pristine golden sands of Banderas Bay. Private elevator access, heated infinity pools, beach club, and bespoke concierge.
        </p>

        <div class="hp-rise hp-delay-2 mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <ScheduleButton class="px-8 py-4 text-base" label="Explore Residences & Book" />
          <a
            href={business.phoneHref}
            class="hp-lift inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-brass text-white hover:text-brass-light px-7 py-3.5 rounded-lg font-display font-bold text-base backdrop-blur-sm bg-navy/40 transition-colors shadow-md"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call Concierge: {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Statistics Ribbon -->
  <section class="bg-navy-800 text-white border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {stats.map((s) => (
          <a href={s.link} class="hp-lift group block p-3 rounded-xl hover:bg-white/5 transition-colors">
            <span class="block font-display font-black text-3xl sm:text-4xl text-brass group-hover:text-brass-light transition-colors">
              {s.title}
            </span>
            <span class="block text-xs uppercase font-bold tracking-wider text-white/70 mt-1">
              {s.label}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Offerings Highlight -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <p class="font-display font-bold text-brass uppercase tracking-[0.25em] text-xs">Excellence in Hospitality &amp; Real Estate</p>
      <h2 class="mt-2 font-display font-black text-3xl sm:text-5xl text-navy">World-Class Coastal Living</h2>
      <p class="mt-4 text-navy/70 text-lg leading-relaxed">
        Whether reserving a vacation stay, purchasing a dream beachfront home, or seeking turnkey property management, Icon Vallarta delivers unmatched pedigree.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {highlights.map((h) => (
        <a href={h.link} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-xl hover:border-brass/50 p-8 flex flex-col justify-between transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-navy text-brass flex items-center justify-center font-bold text-xl mb-6 group-hover:scale-110 transition-transform">
              ✦
            </div>
            <h3 class="font-display font-bold text-2xl text-navy group-hover:text-water transition-colors">{h.title}</h3>
            <p class="mt-3 text-navy/70 leading-relaxed text-sm">{h.desc}</p>
          </div>
          <div class="mt-8 pt-4 border-t border-navy/5 flex items-center text-sm font-bold text-brass group-hover:text-navy transition-colors">
            <span>Learn more</span>
            <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Complete Services Directory -->
  <section class="bg-navy-800/5 py-20 border-y border-navy/10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <p class="font-display font-bold text-brass uppercase tracking-[0.2em] text-xs">Signature Services</p>
          <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">Curated Services &amp; Amenities</h2>
        </div>
        <a href="/services" class="mt-4 md:mt-0 font-display font-bold text-water hover:text-navy transition-colors text-sm">
          View all residences &amp; services →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allServices.map((svc) => (
          <a href={`/services/${svc.id}`} class="hp-lift group bg-white rounded-2xl border border-navy/10 shadow-sm hover:shadow-lg p-6 flex flex-col">
            <h3 class="font-display font-bold text-xl text-navy group-hover:text-water transition-colors">{svc.data.h1}</h3>
            <p class="mt-2 text-sm text-navy/65 flex-1 line-clamp-3">{svc.data.summary}</p>
            <span class="mt-4 font-display font-bold text-brass text-sm group-hover:text-navy transition-colors">Explore details →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Icon Advantage / Why Choose Icon Vallarta -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="font-display font-bold text-brass uppercase tracking-[0.2em] text-xs">The Icon Difference</p>
        <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">Why Discerning Guests &amp; Buyers Choose Us</h2>
        <p class="mt-4 text-navy/70 text-lg leading-relaxed">
          From the avant-garde styling of Philippe Starck to the golden shore of Banderas Bay, Icon Vallarta provides a standard of coastal elegance that traditional hotels simply cannot rival.
        </p>

        <div class="mt-8 space-y-4">
          {painPoints.map((point) => (
            <div class="flex items-start gap-3 bg-white p-4 rounded-xl border border-navy/10 shadow-sm">
              <span class="h-6 w-6 rounded-full bg-brass/20 text-brass flex items-center justify-center shrink-0 text-xs font-black mt-0.5">✓</span>
              <p class="text-sm font-medium text-navy/85">{point}</p>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <ScheduleButton class="px-8 py-4" label="Plan Your Experience" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {galleryProjects.map((p, idx) => (
          <div class={`hp-zoom rounded-2xl shadow-md overflow-hidden ${idx === 0 ? "col-span-2 aspect-[16/9]" : "aspect-square"}`}>
            <img
              src={p.src}
              alt={p.alt}
              width="600"
              height="400"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dynamic Blog Section from Headless CMS API -->
  {featuredPosts.length > 0 && (
    <section class="bg-cream py-20 border-t border-navy/10">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <p class="font-display font-bold text-brass uppercase tracking-[0.2em] text-xs">Official Journal &amp; Updates</p>
            <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">Latest from Our Blog</h2>
          </div>
          <a href="/blog" class="mt-4 md:mt-0 font-display font-bold text-water hover:text-navy transition-colors text-sm">
            Read all articles →
          </a>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          {featuredPosts.map((post) => {
            const formattedDate = formatPostDate(post.published_at);
            const imageUrl = post.featured_image_url || "/images/placeholder.jpeg";
            return (
              <article class="hp-lift group bg-white rounded-2xl overflow-hidden border border-navy/10 shadow-sm hover:shadow-xl flex flex-col transition-all">
                <a href={`/blog/${post.slug}`} class="hp-zoom block relative aspect-[16/10] bg-navy-800/5">
                  <img
                    src={imageUrl}
                    alt={post.title}
                    width="600"
                    height="375"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    onerror="this.onerror=null;this.src='/images/placeholder.jpeg';"
                  />
                </a>
                <div class="p-6 flex flex-col flex-1">
                  {formattedDate && (
                    <time class="text-xs font-semibold uppercase tracking-wider text-brass mb-2">{formattedDate}</time>
                  )}
                  <h3 class="font-display font-bold text-xl text-navy group-hover:text-water transition-colors leading-snug">
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h3>
                  {post.excerpt && (
                    <p class="mt-2.5 text-sm text-navy/70 line-clamp-2 flex-1">{post.excerpt}</p>
                  )}
                  <div class="mt-5 pt-3 border-t border-navy/5">
                    <a href={`/blog/${post.slug}`} class="font-display text-sm font-bold text-water hover:text-navy transition-colors">
                      Read article →
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Reviews Section -->
  <Reviews />

  <!-- Direct Reservation / Inquiry Form Section -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="bg-white rounded-3xl border border-navy/10 shadow-xl p-8 sm:p-12">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <p class="font-display font-bold text-brass uppercase tracking-[0.25em] text-xs">Direct VIP Contact</p>
        <h2 class="mt-2 font-display font-black text-3xl sm:text-4xl text-navy">Plan Your Stay or Private Tour</h2>
        <p class="mt-3 text-navy/70 text-sm sm:text-base">
          Connect with our on-site team for vacation rental availability, penthouse sales inquiries, or bespoke concierge arrangements.
        </p>
      </div>

      <RequestServiceForm />
    </div>
  </section>
</BaseLayout>
