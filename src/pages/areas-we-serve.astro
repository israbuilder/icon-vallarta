---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleButton from "../components/ScheduleButton.astro";
import { business } from "../data/business";
import { areas } from "../data/areas";

const surrounding = [
  { region: "Puerto Vallarta", areas: ["Zona Hotelera Norte", "Marina Vallarta", "Zona Romántica", "Conchas Chinas", "Fluvial Vallarta", "Amapas"] },
  { region: "Riviera Nayarit", areas: ["Nuevo Nayarit (Nuevo Vallarta)", "Bucerías", "La Cruz de Huanacaxtle", "Punta Mita", "Sayulita"] },
];
---
<BaseLayout
  title={`Destinations & Areas We Serve | ${business.name}`}
  description={`Discover luxury oceanfront living across Puerto Vallarta and Banderas Bay. Icon Vallarta is prime beachfront in the North Hotel Zone.`}
  path="/areas-we-serve"
>
  <!-- Banner -->
  <section class="relative isolate overflow-hidden bg-navy text-white border-b-4 border-brass">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <p class="font-display font-bold text-brass-light uppercase tracking-[0.2em] text-xs">Coastal Guide</p>
      <h1 class="hp-rise mt-3 font-display font-black text-4xl sm:text-5xl">Destinations Across Banderas Bay</h1>
      <p class="mt-3 text-white/80 text-lg max-w-2xl">
        Icon Vallarta sits at the center of the bay in the North Hotel Zone, giving you immediate access to Puerto Vallarta's cultural heritage and Riviera Nayarit's pristine waters.
      </p>
    </div>
  </section>

  <section class="px-6 py-16 max-w-5xl mx-auto">
    <p class="text-navy/80 text-lg mb-4">
      {business.name} is ideally positioned directly on the sand of Puerto Vallarta's premier hotel strip. From this prime hub, residents and vacationers easily explore the vibrant historic downtown Malecón, world-class golf in Marina Vallarta, and bespoke excursions north to Punta Mita.
    </p>

    <!-- Featured neighborhood landing pages -->
    <h2 class="font-display font-extrabold text-2xl text-navy mb-2 mt-10">Premier Coastal Enclaves</h2>
    <p class="text-navy/70 mb-6">Explore our dedicated location guides:</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
      {areas.map((a) => (
        <a href={`/areas/${a.slug}`} class="hp-lift group flex items-center justify-between gap-3 bg-white border border-navy/10 rounded-xl px-5 py-4 shadow-sm hover:border-brass/40 hover:shadow-md">
          <span class="flex items-center gap-2.5">
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-navy text-brass">
              ✦
            </span>
            <span class="font-display font-bold text-navy group-hover:text-water transition-colors">{a.name}</span>
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-brass shrink-0" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </div>

    <h2 class="mt-12 font-display font-extrabold text-2xl text-navy mb-6">Regional Highlights</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {surrounding.map((c) => (
        <div class="bg-white border border-navy/10 rounded-xl p-6 shadow-sm">
          <h3 class="flex items-center gap-2 font-display font-bold text-navy mb-4 text-lg">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-navy text-brass text-sm">
              📍
            </span>
            {c.region}
          </h3>
          <div class="flex flex-wrap gap-2">
            {c.areas.map((areaName) => (
              <span class="inline-block bg-cream border border-navy/10 rounded-md px-3 py-1.5 font-display font-semibold text-navy text-xs">{areaName}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-12 text-navy/80 text-lg">
      Have questions about travel logistics, airport transfers, or yacht charters? Call our concierge at
      <a href={business.phoneHref} class="font-bold text-water hover:text-navy transition-colors">{business.phone}</a>.
    </p>
    <div class="mt-8"><ScheduleButton class="px-8 py-4 text-base" label="Plan Your Trip" /></div>
  </section>
</BaseLayout>
